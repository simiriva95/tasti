# --- App (Vercel) ---
# Public base URL (used for SEO canonical/sitemap/OG).
NEXT_PUBLIC_SITE_URL="https://your-app.vercel.app"

# Auth.js v5
AUTH_SECRET=""           # generate: openssl rand -base64 32
AUTH_GOOGLE_ID=""        # Google Cloud OAuth client id
AUTH_GOOGLE_SECRET=""    # Google Cloud OAuth client secret
# AUTH_URL is auto-detected on Vercel; set it locally if needed.

# Neon Postgres (free tier)
DATABASE_URL="postgresql://user:password@host.neon.tech/db?sslmode=require"

# OMR microservice (Render). Same secret on both sides.
OMR_SERVICE_URL="https://your-omr-service.onrender.com"
OMR_SERVICE_SECRET="a-long-random-shared-secret"

# --- OMR service (Render) env ---
# OMR_SERVICE_SECRET="a-long-random-shared-secret"   # must match the app
# AUDIVERIS_CMD="/opt/audiveris/bin/Audiveris"        # set in the Dockerfile
# USE_XVFB="1"                                        # set in the Dockerfile
